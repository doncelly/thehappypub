# Copia este archivo a .env.local y completa con los valores de tu proyecto Supabase
# (Project Settings > API en el dashboard de Supabase).

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# NUNCA exponer al cliente — solo se usa en Server Actions / Route Handlers.
# Necesaria para: crear usuarios (Supabase Auth admin), verificar PIN server-side,
# y cualquier operación que deba saltarse RLS de forma controlada.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

NEXT_PUBLIC_SUPABASE_PROJECT_ID=tu-proyecto-ref

# Actualización automática de la hoja de cierres de caja en Google Sheets
# (botón "Actualizar hoja de cierres" en Panel). Opcional — sin esto la app
# sigue funcionando igual, solo no hay sincronización automática. Ver
# GOOGLE_DRIVE_SETUP.md para los pasos completos.
GOOGLE_SERVICE_ACCOUNT_EMAIL=happy-pub-drive@tu-proyecto.iam.gserviceaccount.com
# La clave privada del JSON que descargas de Google Cloud — pégala tal cual,
# con los \n literales (entre comillas, en una sola línea). Empieza con
# "-----BEGIN PRIVATE KEY-----", NO es el private_key_id (ese es un hash corto).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
# El ID de tu hoja de cálculo de cierres de caja (de la URL:
# docs.google.com/spreadsheets/d/ESTE_ID/edit)
GOOGLE_CIERRES_SHEET_ID=1a2B3c4D5e6F7g8H9iJ0kLmNoPqRsTuV